{
	"name": "your-excellency",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test:e2e": "playwright install && playwright test",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"sim:data": "node scripts/sim-data/fetch.mjs && node scripts/sim-data/build-cells.mjs && node scripts/sim-data/build-national.mjs && node scripts/sim-data/build-development.mjs && node scripts/sim-data/build-wealth.mjs && node scripts/sim-data/build-regional.mjs && node scripts/sim-data/build-world.mjs",
		"sim:calibrate": "vitest run src/lib/game/sim/calibration.test.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "8.0.0-next.3",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.0",
		"@types/three": "0.174.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9",
		"wrangler": "^4.106.0"
	},
	"dependencies": {
		"@svg-maps/nigeria": "^2.0.0",
		"onnxruntime-web": "1.24.3",
		"phonemizer": "1.2.1",
		"three": "0.174.0"
	}
}
